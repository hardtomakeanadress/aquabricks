            <solid android:color="#33FFF4D6" />
        </shape>
    </item>
    <item
        android:left="5dp"
        android:top="5dp"
        android:right="5dp"
        android:bottom="5dp">
        <shape android:shape="oval">
            <solid android:color="#00000000" />
            <stroke android:width="2.5dp" android:color="@color/cream" />
