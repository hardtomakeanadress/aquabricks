<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/deep"
    android:orientation="vertical">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="60dp"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="10dp"
        android:paddingEnd="10dp">

        <TextView
            android:id="@+id/backButton"
            android:layout_width="wrap_content"
            android:layout_height="match_parent"
            android:gravity="center"
            android:paddingStart="10dp"
            android:paddingEnd="10dp"
            android:text="@string/back_arrow"
            android:textColor="@color/accent"
            android:textSize="30sp" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="monospace"
                android:letterSpacing="0.1"
                android:text="@string/edit_title"
                android:textColor="@color/cream"
                android:textSize="15sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="monospace"
                android:letterSpacing="0.08"
                android:text="@string/edit_subtitle"
                android:textColor="@color/muted"
                android:textSize="8sp"
                android:textStyle="bold" />
        </LinearLayout>

        <TextView
            android:id="@+id/retakeButton"
            android:layout_width="wrap_content"
            android:layout_height="match_parent"
            android:gravity="center"
            android:paddingStart="10dp"
            android:paddingEnd="10dp"
            android:text="@string/retake"
            android:textColor="@color/accent"
            android:textSize="10sp"
            android:textStyle="bold" />
    </LinearLayout>

    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:background="@android:color/black"
        android:minHeight="180dp">

        <com.aquabricks.scanner.CropQuadView
            android:id="@+id/cropView"
            android:layout_width="match_parent"
            android:layout_height="match_parent" />

        <ProgressBar
            android:id="@+id/photoLoading"
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:layout_gravity="center"
            android:indeterminateTint="@color/accent" />
    </FrameLayout>

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:background="@color/deep"
        android:fillViewport="true">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="16dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <FrameLayout
                    android:layout_width="92dp"
                    android:layout_height="92dp"
                    android:background="@drawable/bg_input"
                    android:padding="6dp">

                    <ImageView
                        android:id="@+id/previewImage"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:contentDescription="@string/edit_title"
                        android:scaleType="fitCenter" />
                </FrameLayout>

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="12dp"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <EditText
                        android:id="@+id/nameInput"
                        android:layout_width="match_parent"
                        android:layout_height="44dp"
                        android:background="@drawable/bg_input"
                        android:fontFamily="monospace"
                        android:hint="@string/fish_name_hint"
                        android:importantForAutofill="no"
                        android:inputType="textCapWords"
                        android:maxLength="24"
                        android:maxLines="1"
                        android:paddingStart="12dp"
                        android:paddingEnd="12dp"
                        android:textColor="@color/cream"
                        android:textColorHint="@color/muted"
                        android:textSize="14sp" />

                    <EditText
                        android:id="@+id/creatorInput"
                        android:layout_width="match_parent"
                        android:layout_height="44dp"
                        android:layout_marginTop="8dp"
                        android:background="@drawable/bg_input"
                        android:fontFamily="monospace"
                        android:hint="@string/creator_hint"
                        android:importantForAutofill="no"
                        android:inputType="textCapWords"
                        android:maxLength="24"
                        android:maxLines="1"
                        android:paddingStart="12dp"
                        android:paddingEnd="12dp"
                        android:textColor="@color/cream"
                        android:textColorHint="@color/muted"
                        android:textSize="14sp" />
                </LinearLayout>
            </LinearLayout>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:layout_marginBottom="6dp"
                android:fontFamily="monospace"
                android:letterSpacing="0.14"
                android:text="@string/head_facing"
                android:textColor="@color/muted"
                android:textSize="9sp"
                android:textStyle="bold" />

            <LinearLayout
                android:id="@+id/facingRow"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="14dp"
                android:layout_marginBottom="6dp"
                android:fontFamily="monospace"
                android:letterSpacing="0.14"
                android:text="@string/pixel_grid"
                android:textColor="@color/muted"
                android:textSize="9sp"
                android:textStyle="bold" />

            <LinearLayout
                android:id="@+id/gridRow"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="14dp"
                android:layout_marginBottom="2dp"
                android:fontFamily="monospace"
                android:letterSpacing="0.14"
                android:text="@string/cutout"
                android:textColor="@color/muted"
                android:textSize="9sp"
                android:textStyle="bold" />

            <SeekBar
                android:id="@+id/toleranceSeek"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:max="100"
                android:progress="14"
                android:progressBackgroundTint="@color/teal_dim"
                android:progressTint="@color/accent"
                android:thumbTint="@color/accent" />

            <CheckBox
                android:id="@+id/legoColourCheck"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:buttonTint="@color/accent"
                android:checked="true"
                android:fontFamily="monospace"
                android:letterSpacing="0.08"
                android:paddingStart="0dp"
                android:paddingEnd="0dp"
                android:text="@string/lego_colours"
                android:textColor="@color/cream"
                android:textSize="9sp" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <ProgressBar
                    android:id="@+id/processSpinner"
                    android:layout_width="16dp"
                    android:layout_height="16dp"
                    android:layout_marginEnd="8dp"
                    android:indeterminateTint="@color/accent"
                    android:visibility="gone" />

                <TextView
                    android:id="@+id/statusText"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:fontFamily="monospace"
                    android:letterSpacing="0.06"
                    android:text="@string/waiting_photo"
                    android:textColor="@color/cream"
                    android:textSize="10sp" />
            </LinearLayout>

            <Button
                android:id="@+id/faceButton"
                android:layout_width="match_parent"
                android:layout_height="46dp"
                android:layout_marginTop="12dp"
                android:background="@drawable/bg_ghost"
                android:fontFamily="monospace"
                android:letterSpacing="0.08"
                android:stateListAnimator="@null"
                android:text="@string/add_face"
                android:textColor="@color/cream"
                android:textSize="10sp"
                android:textStyle="bold" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:orientation="horizontal">

                <Button
                    android:id="@+id/retakeButton2"
                    android:layout_width="0dp"
                    android:layout_height="52dp"
                    android:layout_marginEnd="10dp"
                    android:layout_weight="0.42"
                    android:background="@drawable/bg_ghost"
                    android:fontFamily="monospace"
                    android:letterSpacing="0.08"
                    android:stateListAnimator="@null"
                    android:text="@string/retake"
                    android:textColor="@color/cream"
                    android:textSize="11sp"
                    android:textStyle="bold" />

                <Button
                    android:id="@+id/sendButton"
                    android:layout_width="0dp"
                    android:layout_height="52dp"
                    android:layout_weight="0.58"
                    android:background="@drawable/bg_primary"
                    android:fontFamily="monospace"
                    android:letterSpacing="0.08"
                    android:stateListAnimator="@null"
                    android:text="@string/send_to_tank"
                    android:textColor="@color/deep"
                    android:textSize="11sp"
                    android:textStyle="bold" />
            </LinearLayout>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:layout_marginBottom="6dp"
                android:alpha="0.6"
                android:fontFamily="monospace"
                android:text="@string/crop_hint"
                android:textColor="@color/muted"
                android:textSize="8sp" />
        </LinearLayout>
    </ScrollView>
</LinearLayout>
